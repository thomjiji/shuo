<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WindowsDictation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    Title="Windows Dictation">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Windows Dictation">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1">
            <StackPanel
                MaxWidth="920"
                HorizontalAlignment="Stretch"
                Padding="32,40,32,32"
                Spacing="18">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="快捷方式" />

                <Border
                    Padding="24"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="28"
                            Glyph="&#xE720;" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="录音触发快捷键" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="开始或停止听写。" />
                        </StackPanel>

                        <StackPanel
                            x:Name="HotkeyPreview"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8" />

                        <Button
                            x:Name="EditShortcutButton"
                            Grid.Column="3"
                            Margin="8,0,0,0"
                            Padding="10"
                            automation:AutomationProperties.Name="编辑录音触发快捷键"
                            Click="EditShortcutButton_Click">
                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE70F;" />
                        </Button>
                    </Grid>
                </Border>

                <InfoBar
                    x:Name="ErrorInfo"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Error" />
            </StackPanel>
        </Grid>

        <ContentDialog
            x:Name="ShortcutDialog"
            Title="录音触发快捷键"
            PrimaryButtonClick="ShortcutDialog_PrimaryButtonClick"
            PrimaryButtonText="保存"
            CloseButtonText="取消"
            DefaultButton="Primary"
            Opened="ShortcutDialog_Opened">
            <StackPanel Width="620" Spacing="20">
                <TextBlock
                    FontSize="16"
                    Text="快捷键应以 Windows 键、Ctrl、Alt 或 Shift 开头。"
                    TextWrapping="Wrap" />

                <Button
                    x:Name="ShortcutCaptureSurface"
                    automation:AutomationProperties.Name="快捷键捕获区域"
                    MinHeight="110"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    KeyDown="ShortcutCaptureSurface_KeyDown">
                    <Grid>
                        <TextBlock
                            x:Name="ShortcutCapturePlaceholder"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="按下新的快捷键" />
                        <StackPanel
                            x:Name="ShortcutDialogKeys"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="14" />
                    </Grid>
                </Button>

                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="24">
                    <Button
                        automation:AutomationProperties.Name="重置快捷键"
                        Click="ResetShortcutButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="重置" />
                        </StackPanel>
                    </Button>
                    <Button
                        automation:AutomationProperties.Name="清除快捷键"
                        Click="ClearShortcutButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE711;" />
                            <TextBlock Text="清除" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock
                    x:Name="ShortcutDialogValidation"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
