<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WindowsDictation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    Title="Windows Dictation">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Windows Dictation">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1">
            <StackPanel
                MaxWidth="920"
                HorizontalAlignment="Stretch"
                Padding="32,40,32,32"
                Spacing="14">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="快捷方式" />

                <Border
                    Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="24"
                            Glyph="&#xE720;" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="录音触发快捷键" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="开始或停止听写。" />
                        </StackPanel>

                        <StackPanel
                            x:Name="HotkeyPreview"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6" />

                        <Button
                            x:Name="EditShortcutButton"
                            Grid.Column="3"
                            Margin="6,0,0,0"
                            Padding="8"
                            automation:AutomationProperties.Name="编辑录音触发快捷键"
                            Click="EditShortcutButton_Click">
                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE70F;" />
                        </Button>
                    </Grid>
                </Border>

                <InfoBar
                    x:Name="ErrorInfo"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Error" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="ShortcutEditorOverlay"
            Grid.Row="1"
            Background="#99000000"
            Visibility="Collapsed">
            <Border
                MinWidth="460"
                MaxWidth="600"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="24"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel>

                    <StackPanel Padding="28" Spacing="14">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="录音触发快捷键" />
                        <TextBlock
                            FontSize="14"
                            Text="快捷键应以 Windows 键、Ctrl、Alt 或 Shift 开头。"
                            TextWrapping="Wrap" />

                        <Button
                            x:Name="ShortcutCaptureSurface"
                            MinHeight="80"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            automation:AutomationProperties.Name="快捷键捕获区域"
                            KeyDown="ShortcutCaptureSurface_KeyDown">
                            <Grid>
                                <TextBlock
                                    x:Name="ShortcutEditorPlaceholder"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="按下新的快捷键" />
                                <StackPanel
                                    x:Name="ShortcutEditorKeys"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="12" />
                            </Grid>
                        </Button>

                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="20">
                            <Button
                                Padding="8,4"
                                automation:AutomationProperties.Name="重置快捷键"
                                Click="ResetShortcutButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE72C;" />
                                    <TextBlock FontSize="12" Text="重置" />
                                </StackPanel>
                            </Button>
                            <Button
                                Padding="8,4"
                                automation:AutomationProperties.Name="清除快捷键"
                                Click="ClearShortcutButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE711;" />
                                    <TextBlock FontSize="12" Text="清除" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock
                            x:Name="ShortcutEditorValidation"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Border
                        Padding="20,14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12">
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="SaveShortcutButton"
                                MinWidth="88"
                                MinHeight="36"
                                Click="SaveShortcutButton_Click"
                                Content="保存"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                MinWidth="88"
                                MinHeight="36"
                                Click="CancelShortcutButton_Click"
                                Content="取消" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
