<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WindowsDictation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    Title="Windows Dictation">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Windows Dictation">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="920"
                HorizontalAlignment="Stretch"
                Padding="32,24,32,24"
                Spacing="12">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="快捷方式" />

                <Border
                    Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="24"
                                Glyph="&#xE720;" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="录音触发快捷键" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="开始或停止听写。" />
                            </StackPanel>

                            <StackPanel
                                x:Name="HotkeyPreview"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6" />

                            <Button
                                x:Name="EditShortcutButton"
                                Grid.Column="3"
                                Margin="6,0,0,0"
                                Padding="8"
                                automation:AutomationProperties.Name="编辑录音触发快捷键"
                                Click="EditShortcutButton_Click">
                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE70F;" />
                            </Button>
                        </Grid>

                        <Border
                            x:Name="ShortcutEditorPanel"
                            Margin="0,14,0,0"
                            Padding="0,14,0,0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="按下新的组合键，或选择重置、清除。" />

                                <Button
                                    x:Name="ShortcutCaptureSurface"
                                    MinHeight="48"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    automation:AutomationProperties.Name="快捷键捕获区域"
                                    KeyDown="ShortcutCaptureSurface_KeyDown">
                                    <Grid>
                                        <TextBlock
                                            x:Name="ShortcutEditorPlaceholder"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="按下新的快捷键" />
                                        <StackPanel
                                            x:Name="ShortcutEditorKeys"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6" />
                                    </Grid>
                                </Button>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Padding="8,4"
                                            automation:AutomationProperties.Name="重置快捷键"
                                            Click="ResetShortcutButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE72C;" />
                                                <TextBlock FontSize="12" Text="重置" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Padding="8,4"
                                            automation:AutomationProperties.Name="清除快捷键"
                                            Click="ClearShortcutButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE711;" />
                                                <TextBlock FontSize="12" Text="清除" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button
                                            x:Name="SaveShortcutButton"
                                            MinWidth="80"
                                            MinHeight="32"
                                            Click="SaveShortcutButton_Click"
                                            Content="保存"
                                            Style="{StaticResource AccentButtonStyle}" />
                                        <Button
                                            MinWidth="80"
                                            MinHeight="32"
                                            Click="CancelShortcutButton_Click"
                                            Content="取消" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    x:Name="ShortcutEditorValidation"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="文本整理" />
                <Border
                    Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="去除口水词" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="清除停顿中的“嗯、呃”等填充音，尽量保留有意义的语气。" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="RemoveFillerWordsToggle" Grid.Column="1" VerticalAlignment="Center"
                                          OffContent="" OnContent="" MinWidth="0"
                                          automation:AutomationProperties.Name="去除口水词"
                                          Toggled="TextCleanupToggle_Toggled" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="去掉末尾句号" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="保留句中标点、问号和感叹号。" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="TrimTrailingPeriodToggle" Grid.Column="1" VerticalAlignment="Center"
                                          OffContent="" OnContent="" MinWidth="0"
                                          automation:AutomationProperties.Name="去掉末尾句号"
                                          Toggled="TextCleanupToggle_Toggled" />
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="关闭窗口后仍在托盘运行。右键托盘图标可退出。" TextWrapping="Wrap" />

                <InfoBar
                    x:Name="ErrorInfo"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Error" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
