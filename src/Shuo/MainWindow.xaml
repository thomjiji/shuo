<?xml version="1.0" encoding="utf-8" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:automation="using:Microsoft.UI.Xaml.Automation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Shuo.MainWindow" Title="说">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.Resources>
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="16" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="说">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>
        <NavigationView x:Name="SettingsNavigation" Grid.Row="1" PaneDisplayMode="Auto" OpenPaneLength="160" CompactModeThresholdWidth="640" ExpandedModeThresholdWidth="900" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" AlwaysShowHeader="False" SelectionChanged="SettingsNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="ListenNavigationItem" Content="语音输入" Tag="listen" Icon="Microphone" />
                <NavigationViewItem x:Name="CaptionNavigationItem" Content="实时字幕" Tag="captions" Icon="ClosedCaption" />
                <NavigationViewItem x:Name="SpeakNavigationItem" Content="朗读" Tag="reading" Icon="Volume" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="历史" Tag="history" Icon="Clock" />
                <NavigationViewItem x:Name="ServicesNavigationItem" Content="服务设置" Tag="services" Icon="Setting" />
                <NavigationViewItem x:Name="GeneralNavigationItem" Content="关于" Tag="general">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="UpdateInfoBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Grid x:Name="PageViewport" SizeChanged="PageViewport_SizeChanged">
                <ScrollViewer x:Name="PageScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="SettingsContent" Width="640" HorizontalAlignment="Center" Margin="0,36,0,36" Spacing="24">
                        <StackPanel x:Name="PageSurface" Spacing="24">
                            <TextBlock x:Name="PageTitle" Text="语音输入" Style="{StaticResource TitleTextBlockStyle}" />
                            <Grid>
                                <StackPanel x:Name="ListenPage" Spacing="16" Visibility="Collapsed">
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="快捷键" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                <Button x:Name="TranscriptionShortcutButton" Content="设置快捷键" Click="TranscriptionShortcut_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnSpacing="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="试用" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <Button Grid.Column="1" x:Name="ListenButton" Content="开始" Click="Listen_Click" Style="{StaticResource AccentButtonStyle}" />
                                            </Grid>
                                            <TextBox x:Name="ListenResult" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="240" automation:AutomationProperties.Name="语音输入试用结果" />
                                            <TextBlock x:Name="ListenStatus" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Expander Header="输入设置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="16">
                                            <Grid ColumnSpacing="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="识别服务" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <ComboBox Grid.Column="1" x:Name="ProviderPicker" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="ProviderPicker_SelectionChanged">
                                                    <ComboBoxItem Content="本机模型" />
                                                    <ComboBoxItem Content="火山引擎" />
                                                    <ComboBoxItem Content="阿里云百炼" />
                                                    <ComboBoxItem Content="自托管 Mac" />
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="去掉末尾句号" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <ToggleSwitch Grid.Column="1" x:Name="TrimTrailingPeriodToggle" OffContent="" OnContent="" MinWidth="0" automation:AutomationProperties.Name="去掉末尾句号" Toggled="TextCleanupToggle_Toggled" />
                                            </Grid>
                                            <TextBlock x:Name="CloudStatus" TextWrapping="Wrap" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                                <StackPanel x:Name="CaptionPage" Spacing="16" Visibility="Collapsed">
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="快捷键" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                <Button x:Name="TranslationShortcutButton" Content="设置快捷键" Click="TranslationShortcut_Click" />
                                                <ToggleSwitch x:Name="TranslationEnabled" OffContent="" OnContent="" MinWidth="0" VerticalAlignment="Center" automation:AutomationProperties.Name="启用快捷键" Toggled="TranslationToggle_Changed" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel Spacing="16">
                                            <Grid ColumnSpacing="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="字幕语言" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <ComboBox Grid.Column="1" x:Name="CaptionLanguage" SelectionChanged="ListenChoice_Changed" SelectedIndex="0" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem Content="原文" />
                                                    <ComboBoxItem Content="中文翻译" />
                                                    <ComboBoxItem Content="英文翻译" />
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="TranslationStatus" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                <Button x:Name="CaptionButton" Grid.Column="1" Content="开启字幕" Click="Caption_Click" Style="{StaticResource AccentButtonStyle}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Expander Header="字幕设置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="16">
                                            <Grid ColumnSpacing="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="翻译服务" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <ComboBox Grid.Column="1" x:Name="TranslationModelPicker" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="TranslationBackend_Changed">
                                                    <ComboBoxItem>
                                                        <StackPanel>
                                                            <TextBlock Text="阿里云百炼" />
                                                            <TextBlock x:Name="CaptionCloudModel" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </ComboBoxItem>
                                                    <ComboBoxItem>
                                                        <StackPanel>
                                                            <TextBlock Text="自托管 Mac" />
                                                            <TextBlock Text="mlx-community/Qwen3-8B-4bit" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </ComboBoxItem>
                                                </ComboBox>
                                            </Grid>
                                            <Button x:Name="TranslationSaveButton" Content="保存" HorizontalAlignment="Right" Click="TranslationSave_Click" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                                <StackPanel x:Name="HistoryPage" Spacing="12" Visibility="Collapsed">
                                    <TextBlock Text="完成转录后自动保存最终文字。记录仅保存在这台电脑上，重启后仍可查看。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox x:Name="HistorySearch" PlaceholderText="搜索全部记录的文字、日期或服务" automation:AutomationProperties.Name="搜索转录历史" TextChanged="HistorySearch_TextChanged" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Content="打开历史文件" Click="OpenHistory_Click" />
                                        <Button Content="导出并打开文本" Click="ExportHistory_Click" />
                                        <Button Content="刷新" Click="RefreshHistory_Click" />
                                        <TextBlock x:Name="HistoryCount" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="HistoryNotice" TextWrapping="Wrap" />
                                    <TextBlock x:Name="HistoryEmpty" Text="还没有转录记录。完成一次听写后会显示在这里。" TextWrapping="Wrap" />
                                    <ItemsControl x:Name="HistoryItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="16" Margin="0,0,0,16" CornerRadius="8" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                    <StackPanel Spacing="12">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayTime}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding DisplayProvider}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="复制" Tag="{Binding Text}" Click="CopyHistory_Click" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button x:Name="MoreHistoryButton" Content="加载更多" Click="MoreHistory_Click" Visibility="Collapsed" />
                                </StackPanel>
                                <StackPanel x:Name="GeneralPage" Spacing="16" Visibility="Collapsed">
                                    <Border Padding="16" CornerRadius="8" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="版本与更新" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Name="AppVersionLabel" IsTextSelectionEnabled="True" />
                                            <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click" />
                                                <Button x:Name="InstallUpdateButton" Content="更新并重启" Click="InstallUpdate_Click" Visibility="Collapsed" />
                                            </StackPanel>
                                            <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="关闭窗口后仍在托盘运行。右键托盘图标可退出。" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel x:Name="ServicesPage" Spacing="16" Visibility="Collapsed">
                                    <Expander x:Name="LocalServiceExpander" Header="本机模型" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="12">
                                            <StackPanel x:Name="LocalModelCard" Spacing="12">
                                                <Grid RowSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <ComboBox x:Name="ModelPicker" HorizontalAlignment="Stretch" IsEnabled="False" PlaceholderText="正在读取模型..." DisplayMemberPath="Name" MaxDropDownHeight="320" automation:AutomationProperties.Name="转录模型" SelectionChanged="ModelPicker_SelectionChanged" />
                                                    <Button x:Name="DownloadModelButton" Grid.Column="1" Content="下载" Margin="8,0,0,0" Visibility="Collapsed" VerticalAlignment="Top" ToolTipService.ToolTip="下载 Qwen3-ASR-0.6B Q8_0，约 811 MB" Click="DownloadModelButton_Click" />
                                                    <ProgressBar x:Name="ModelDownloadProgress" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Maximum="100" />
                                                    <TextBlock x:Name="ModelDownloadStatus" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>
                                            </StackPanel>
                                            <TextBlock Text="在“语音输入 -&gt; 输入设置”中选择本机模型后，可切换已下载的模型。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Expander>
                                    <Expander x:Name="MacServiceExpander" Header="自托管 Mac" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="16">
                                            <Grid ColumnSpacing="24" x:Name="SharedMacHostRow">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Mac 主机名或 IP" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <TextBox Grid.Column="1" x:Name="SharedMacHost" PlaceholderText="100.x.x.x" />
                                            </Grid>
                                            <Grid ColumnSpacing="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="分别指定主机" VerticalAlignment="Center" />
                                                <ToggleSwitch x:Name="SeparateMacHosts" Toggled="SeparateMacHosts_Toggled" Grid.Column="1" OffContent="" OnContent="" MinWidth="0" />
                                            </Grid>
                                            <StackPanel x:Name="MacHostOverrides" Spacing="12" Visibility="Collapsed">
                                                <Grid ColumnSpacing="24">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="2*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="语音输入的识别地址" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    <TextBox Grid.Column="1" x:Name="SelfHostedUrl" />
                                                </Grid>
                                                <Grid ColumnSpacing="24">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="2*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="字幕的 Mac 地址" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    <TextBox Grid.Column="1" x:Name="TranslationHost" />
                                                </Grid>
                                                <Grid ColumnSpacing="24">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="2*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="朗读与中文译读的 Mac 地址" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    <TextBox Grid.Column="1" x:Name="ReadingLocalHost" />
                                                </Grid>
                                            </StackPanel>
                                            <Grid ColumnSpacing="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="语音输入的识别模型" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <ComboBox Grid.Column="1" x:Name="SelfHostedModelPicker" SelectedIndex="0" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem Content="Qwen3-ASR 1.7B" />
                                                    <ComboBoxItem Content="Qwen3-ASR 0.6B" />
                                                </ComboBox>
                                            </Grid>
                                            <Button x:Name="MacTestButton" HorizontalAlignment="Right" Content="测试连接与可用能力" Click="MacTest_Click" />
                                            <TextBlock x:Name="MacServiceStatus" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Expander>
                                    <Expander x:Name="DoubaoServiceExpander" Header="火山引擎 / 豆包" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="16">
                                            <Grid ColumnSpacing="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="转录 API" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <PasswordBox Grid.Column="1" x:Name="CloudApiKey" PasswordRevealMode="Peek" />
                                            </Grid>
                                            <Grid ColumnSpacing="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="语音识别模型" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <ComboBox Grid.Column="1" x:Name="DoubaoModelPicker" SelectedIndex="0" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem Content="豆包流式语音识别模型 2.0" />
                                                    <ComboBoxItem Content="豆包流式语音识别模型 1.0" />
                                                    <ComboBoxItem Content="已保存的资源" />
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="朗读共用转录 API" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <ToggleSwitch Grid.Column="1" x:Name="ReadingUseExistingKey" IsOn="True" OffContent="" OnContent="" MinWidth="0" Toggled="ReadingCredential_Changed" />
                                            </Grid>
                                            <Grid x:Name="ReadingApiKeyCard" Visibility="Collapsed">
                                                <Grid ColumnSpacing="24">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="2*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="朗读 API" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    <PasswordBox Grid.Column="1" x:Name="ReadingApiKey" PasswordRevealMode="Peek" />
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                    <Expander x:Name="BailianServiceExpander" Header="阿里云百炼" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="16">
                                            <Grid ColumnSpacing="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="语音识别 API Key" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <PasswordBox Grid.Column="1" x:Name="QwenApiKey" PasswordRevealMode="Peek" />
                                            </Grid>
                                            <Grid ColumnSpacing="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="语音识别模型" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <ComboBox Grid.Column="1" x:Name="QwenModelPicker" SelectedIndex="0" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem Content="Fun-ASR-Realtime" />
                                                    <ComboBoxItem Content="Qwen3-ASR-Flash-Realtime" />
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="字幕翻译 Workspace ID" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <TextBox Grid.Column="1" x:Name="TranslationWorkspace" PlaceholderText="ws-..." />
                                            </Grid>
                                            <Grid ColumnSpacing="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="字幕翻译 API Key" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <PasswordBox Grid.Column="1" x:Name="TranslationApiKey" PasswordRevealMode="Peek" />
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                    <Button x:Name="ServicesSaveButton" HorizontalAlignment="Right" Content="保存服务设置" Click="ServicesSave_Click" Style="{StaticResource AccentButtonStyle}" />
                                    <TextBlock x:Name="ServicesStatus" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel x:Name="ReadingPage" Spacing="16" Visibility="Collapsed">
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="快捷键" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                <Button x:Name="ReadingShortcutButton" Content="设置快捷键" Click="ReadingShortcut_Click" />
                                                <ToggleSwitch x:Name="ReadingEnabled" OffContent="" OnContent="" MinWidth="0" VerticalAlignment="Center" automation:AutomationProperties.Name="启用快捷键" Toggled="ReadingToggle_Changed" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="ReadingDailyOptions" Style="{StaticResource SettingsCardStyle}">
                                        <Grid ColumnSpacing="24" RowSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="方式" VerticalAlignment="Center" />
                                            <ComboBox x:Name="ReadingMode" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="ReadingMode_Changed" automation:AutomationProperties.Name="朗读方式">
                                                <ComboBoxItem Content="原文朗读" />
                                                <ComboBoxItem Content="中文译读" />
                                            </ComboBox>
                                            <TextBlock Grid.Row="2" Text="速度" VerticalAlignment="Center" />
                                            <Grid Grid.Row="2" Grid.Column="1">
                                                <ComboBox x:Name="ReadingLocalSpeed" SelectedIndex="1" HorizontalAlignment="Stretch" Visibility="Collapsed" SelectionChanged="ReadingLocalSettings_Changed" automation:AutomationProperties.Name="播放速度">
                                                    <ComboBoxItem Content="0.85 倍" />
                                                    <ComboBoxItem Content="1 倍" />
                                                    <ComboBoxItem Content="1.15 倍" />
                                                    <ComboBoxItem Content="1.3 倍" />
                                                </ComboBox>
                                                <Grid x:Name="ReadingCloudSpeed" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Slider x:Name="ReadingSpeed" Minimum="-50" Maximum="100" StepFrequency="10" SmallChange="10" LargeChange="20" SnapsTo="StepValues" IsThumbToolTipEnabled="True" Value="0" VerticalAlignment="Center" ValueChanged="ReadingSpeed_ValueChanged" automation:AutomationProperties.Name="播放速度" />
                                                    <TextBlock x:Name="ReadingSpeedValue" Grid.Column="1" Text="正常" MinWidth="36" VerticalAlignment="Center" />
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="ReadingDailyText" Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel Spacing="12">
                                            <TextBox x:Name="ReadingTextBox" Header="原文" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MinHeight="120" MaxHeight="220" MaxLength="30000" PlaceholderText="输入或粘贴文字" />
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                    <Button x:Name="ReadingButton" Content="朗读" Style="{StaticResource AccentButtonStyle}" Click="ReadingButton_Click" />
                                                    <Button x:Name="ReadingPause" Content="暂停" IsEnabled="False" Click="ReadingPause_Click" />
                                                    <Button x:Name="ReadingStop" Content="停止" IsEnabled="False" Click="ReadingStop_Click" />
                                                </StackPanel>
                                                <TextBlock x:Name="ReadingStatus" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                            <TextBox x:Name="ReadingTranslatedText" Header="译文" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="200" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                    <Expander x:Name="ReadingSettingsExpander" Header="朗读设置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="16">
                                            <Grid ColumnSpacing="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="声音服务" VerticalAlignment="Center" />
                                                <Grid Grid.Column="1">
                                                    <ComboBox x:Name="ReadingOriginalBackend" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="ReadingLocalSettings_Changed" automation:AutomationProperties.Name="声音服务">
                                                        <ComboBoxItem Content="豆包" />
                                                        <ComboBoxItem Content="自托管 Mac" />
                                                    </ComboBox>
                                                    <ComboBox x:Name="ReadingTranslationBackend" SelectedIndex="0" HorizontalAlignment="Stretch" Visibility="Collapsed" SelectionChanged="ReadingLocalSettings_Changed" automation:AutomationProperties.Name="声音服务">
                                                        <ComboBoxItem Content="豆包" />
                                                        <ComboBoxItem Content="自托管 Mac" />
                                                    </ComboBox>
                                                </Grid>
                                            </Grid>
                                            <Grid>
                                                <Grid ColumnSpacing="24">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="2*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="音色" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    <Grid Grid.Column="1">
                                                        <ComboBox x:Name="ReadingSpeaker" HorizontalAlignment="Stretch" DisplayMemberPath="Name" MaxDropDownHeight="320" />
                                                        <TextBlock x:Name="ReadingFixedVoice" Text="Serena" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                            <Button x:Name="ReadingSaveButton" HorizontalAlignment="Right" Content="保存朗读设置" Click="ReadingSave_Click" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <InfoBar x:Name="ErrorInfo" IsClosable="True" IsOpen="False" Severity="Error" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
