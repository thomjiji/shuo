<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Shuo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    Title="说">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="说">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView x:Name="SettingsNavigation" Grid.Row="1"
                        PaneDisplayMode="Auto" OpenPaneLength="200"
                        CompactModeThresholdWidth="0" ExpandedModeThresholdWidth="1040"
                        IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                        AlwaysShowHeader="False" SelectionChanged="SettingsNavigation_SelectionChanged">
            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <AcrylicBrush x:Key="NavigationViewDefaultPaneBackground"
                                          TintColor="#202020" TintOpacity="0.10"
                                          TintLuminosityOpacity="0.65" FallbackColor="#2C2C2C" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <AcrylicBrush x:Key="NavigationViewDefaultPaneBackground"
                                          TintColor="#FCFCFC" TintOpacity="0.0"
                                          TintLuminosityOpacity="0.65" FallbackColor="#F9F9F9" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground"
                                             Color="{ThemeResource SystemColorWindowColor}" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="GeneralNavigationItem" Content="常规" Tag="general" Icon="Setting">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="UpdateInfoBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="TranscriptionNavigationItem" Content="转录服务" Tag="transcription" Icon="Microphone" />
                <NavigationViewItem Content="实时翻译" Tag="translation" Icon="Globe" />
                <NavigationViewItem x:Name="ReadingNavigationItem" Content="实时朗读" Tag="reading" Icon="Volume" />
                <NavigationViewItem Content="转录历史" Tag="history" Icon="Clock" />
                <NavigationViewItem Content="文本整理" Tag="cleanup" Icon="Edit" />
            </NavigationView.MenuItems>
            <Grid x:Name="PageViewport" SizeChanged="PageViewport_SizeChanged">
                <ScrollViewer x:Name="PageScroll" HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="SettingsContent" Width="640" HorizontalAlignment="Center"
                                Margin="0,24,0,24" Spacing="12">
                        <TextBlock x:Name="PageTitle" Text="转录服务" FontSize="28"
                                   FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel x:Name="HistoryPage" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="完成转录后自动保存最终文字。记录仅保存在这台电脑上，重启后仍可查看。"
                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="HistorySearch" PlaceholderText="搜索全部记录的文字、日期或服务"
                                     automation:AutomationProperties.Name="搜索转录历史" TextChanged="HistorySearch_TextChanged" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="打开历史文件" Click="OpenHistory_Click" />
                                <Button Content="导出并打开文本" Click="ExportHistory_Click" />
                                <Button Content="刷新" Click="RefreshHistory_Click" />
                                <TextBlock x:Name="HistoryCount" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="HistoryNotice" TextWrapping="Wrap" />
                            <TextBlock x:Name="HistoryEmpty" Text="还没有转录记录。完成一次听写后会显示在这里。" TextWrapping="Wrap" />
                            <ItemsControl x:Name="HistoryItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="18" Margin="0,0,0,12" CornerRadius="8" BorderThickness="1"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayTime}" FontSize="12"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{Binding DisplayProvider}" FontSize="12" TextWrapping="Wrap"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="复制" Tag="{Binding Text}" Click="CopyHistory_Click" />
                                                </Grid>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="MoreHistoryButton" Content="加载更多" Click="MoreHistory_Click" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel x:Name="GeneralPage" Spacing="12" Visibility="Collapsed">
                            <Border Padding="18" CornerRadius="8" BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="版本与更新" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AppVersionLabel" IsTextSelectionEnabled="True" />
                                    <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click" />
                                        <Button x:Name="InstallUpdateButton" Content="更新并重启" Click="InstallUpdate_Click" Visibility="Collapsed" />
                                    </StackPanel>
                                    <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                            <Border
                                Padding="18"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="24"
                                            Glyph="&#xE720;" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="录音触发快捷键" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="开始或停止听写。" />
                                        </StackPanel>

                                        <StackPanel
                                            x:Name="HotkeyPreview"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6" />

                                        <Button
                                            x:Name="EditShortcutButton"
                                            Grid.Column="3"
                                            Margin="6,0,0,0"
                                            Padding="8"
                                            automation:AutomationProperties.Name="编辑录音触发快捷键"
                                            Click="EditShortcutButton_Click">
                                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE70F;" />
                                        </Button>
                                    </Grid>

                                    <Border
                                        x:Name="ShortcutEditorPanel"
                                        Margin="0,14,0,0"
                                        Padding="0,14,0,0"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0"
                                        Visibility="Collapsed">
                                        <StackPanel Spacing="10">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="按下新的组合键，或选择重置、清除。" />

                                            <Button
                                                x:Name="ShortcutCaptureSurface"
                                                MinHeight="48"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                automation:AutomationProperties.Name="快捷键捕获区域"
                                                KeyDown="ShortcutCaptureSurface_KeyDown">
                                                <Grid>
                                                    <TextBlock
                                                        x:Name="ShortcutEditorPlaceholder"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="按下新的快捷键" />
                                                    <StackPanel
                                                        x:Name="ShortcutEditorKeys"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="6" />
                                                </Grid>
                                            </Button>

                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button
                                                        Padding="8,4"
                                                        automation:AutomationProperties.Name="重置快捷键"
                                                        Click="ResetShortcutButton_Click">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE72C;" />
                                                            <TextBlock FontSize="12" Text="重置" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button
                                                        Padding="8,4"
                                                        automation:AutomationProperties.Name="清除快捷键"
                                                        Click="ClearShortcutButton_Click">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE711;" />
                                                            <TextBlock FontSize="12" Text="清除" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                    <Button
                                                        x:Name="SaveShortcutButton"
                                                        MinWidth="80"
                                                        MinHeight="32"
                                                        Click="SaveShortcutButton_Click"
                                                        Content="保存"
                                                        Style="{StaticResource AccentButtonStyle}" />
                                                    <Button
                                                        MinWidth="80"
                                                        MinHeight="32"
                                                        Click="CancelShortcutButton_Click"
                                                        Content="取消" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock
                                                x:Name="ShortcutEditorValidation"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="关闭窗口后仍在托盘运行。右键托盘图标可退出。" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="TranscriptionPage" Spacing="12">
                            <Border Padding="18"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="转录服务" />
                                    <StackPanel x:Name="CloudControls" Spacing="10">
                                        <ComboBox x:Name="ProviderPicker" SelectedIndex="0" HorizontalAlignment="Stretch"
                                                  SelectionChanged="ProviderPicker_SelectionChanged">
                                            <ComboBoxItem Content="本地模型" />
                                            <ComboBoxItem Content="火山引擎" />
                                            <ComboBoxItem Content="阿里云百炼" />
                                            <ComboBoxItem Content="自托管（MLX）" />
                                        </ComboBox>
                                        <StackPanel x:Name="CloudFields" Spacing="8" Visibility="Collapsed">
                                            <ComboBox x:Name="DoubaoModelPicker" Header="识别模型" HorizontalAlignment="Stretch" SelectedIndex="0">
                                                <ComboBoxItem Content="豆包流式语音识别模型 2.0" />
                                                <ComboBoxItem Content="豆包流式语音识别模型 1.0" />
                                                <ComboBoxItem Content="自定义资源" />
                                            </ComboBox>
                                            <PasswordBox x:Name="CloudApiKey" Header="语音控制台 API Key" PasswordRevealMode="Peek" />
                                            <Expander x:Name="DoubaoResourceSettings" Header="旧版控制台凭据与资源设置" HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Stretch">
                                                <StackPanel Spacing="8">
                                                    <TextBox x:Name="CloudAppId" Header="App ID（旧版控制台）" />
                                                    <PasswordBox x:Name="CloudAccessToken" Header="Access Token（旧版控制台）" PasswordRevealMode="Peek" />
                                                    <TextBox x:Name="CloudResourceId" Header="资源 ID"
                                                             Text="volc.seedasr.sauc.duration" />
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                        <StackPanel x:Name="SelfHostedFields" Spacing="8" Visibility="Collapsed">
                                            <ComboBox x:Name="SelfHostedModelPicker" Header="识别模型" HorizontalAlignment="Stretch" SelectedIndex="0">
                                                <ComboBoxItem Content="Qwen3-ASR 1.7B" />
                                                <ComboBoxItem Content="Qwen3-ASR 0.6B" />
                                            </ComboBox>
                                            <TextBox x:Name="SelfHostedUrl" Header="主机 IP"
                                                     PlaceholderText="输入 Mac 的 Tailscale IP，如 100.x.x.x"
                                                     automation:AutomationProperties.Name="自托管主机 IP" />
                                            <TextBlock Text="音频发送到你部署的识别服务。服务所在电脑需保持在线。"
                                                       FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button x:Name="SelfHostedTestButton" Content="测试连接" Click="SelfHostedTest_Click" />
                                        </StackPanel>
                                        <StackPanel x:Name="QwenFields" Spacing="8" Visibility="Collapsed">
                                            <ComboBox x:Name="QwenModelPicker" Header="识别模型" SelectedIndex="0" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="Fun-ASR-Realtime" />
                                                <ComboBoxItem Content="Qwen3-ASR-Flash-Realtime" />
                                            </ComboBox>
                                            <PasswordBox x:Name="QwenApiKey" Header="百炼 API Key"
                                                         automation:AutomationProperties.Name="百炼 API Key" PasswordRevealMode="Peek" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel x:Name="LocalModelCard" Spacing="8">
                                        <TextBlock Text="模型" />
                                        <Grid RowSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ComboBox x:Name="ModelPicker" HorizontalAlignment="Stretch"
                                                      IsEnabled="False" PlaceholderText="正在读取模型..."
                                                      DisplayMemberPath="Name" MaxDropDownHeight="320"
                                                      automation:AutomationProperties.Name="转录模型"
                                                      SelectionChanged="ModelPicker_SelectionChanged" />
                                            <Button x:Name="DownloadModelButton" Grid.Column="1" Content="下载" Margin="8,0,0,0"
                                                    Visibility="Collapsed" VerticalAlignment="Top"
                                                    ToolTipService.ToolTip="下载 Qwen3-ASR-0.6B Q8_0，约 811 MB"
                                                    Click="DownloadModelButton_Click" />
                                            <ProgressBar x:Name="ModelDownloadProgress" Grid.Row="1"
                                                         Visibility="Collapsed" Maximum="100" />
                                        </Grid>
                                        <TextBlock x:Name="ModelDownloadStatus" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="CloudStatus" Visibility="Collapsed" FontSize="12"
                                               Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="DictationTrialCard" Padding="18" CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="试用听写" FontSize="16" FontWeight="SemiBold" />
                                    <TextBox MinHeight="100" AcceptsReturn="True" TextWrapping="Wrap"
                                             PlaceholderText="今天的天气不错，我们来试试语音输入。"
                                             automation:AutomationProperties.Name="听写试用输入框" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="ReadingPage" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="选中文字，让豆包读给你听。触发时优先读取系统选区，必要时临时复制取词，再恢复未被其他操作改动的剪贴板。朗读文字发送到火山引擎，不保存原文和音频。"
                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Border Padding="18" CornerRadius="8" BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel x:Name="ReadingConfiguration" Spacing="12">
                                    <ToggleSwitch x:Name="ReadingEnabled" Header="启用实时朗读" OffContent="关闭" OnContent="开启" Toggled="ReadingToggle_Changed" />
                                    <Button x:Name="ReadingShortcutButton" Content="Ctrl + Alt + Space" Click="ReadingShortcut_Click" automation:AutomationProperties.Name="更改朗读快捷键" />
                                    <TextBlock Text="点击上方按钮更改朗读快捷键。按快捷键朗读选区，再按一次停止。没有选中文字时不朗读。开启功能后请保存设置。"
                                               FontSize="12" TextWrapping="Wrap" />
                                    <ToggleSwitch x:Name="ReadingUseExistingKey" Header="使用转录服务中的火山引擎 API Key" IsOn="True"
                                                  OffContent="单独配置" OnContent="使用已有 Key" Toggled="ReadingToggle_Changed" />
                                    <PasswordBox x:Name="ReadingApiKey" Header="朗读 API Key" PasswordRevealMode="Peek" />
                                    <TextBlock Text="豆包语音合成 2.0" FontWeight="SemiBold" />
                                    <TextBox x:Name="ReadingSpeaker" Header="音色 ID" Text="zh_female_vv_uranus_bigtts" />
                                    <TextBlock Text="默认使用 vv 音色；可从官方音色列表选择其他语音合成 2.0 音色。"
                                               TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <HyperlinkButton Content="查看可用的系统音色" NavigateUri="https://www.volcengine.com/docs/6561/1257544" />
                                    <Slider x:Name="ReadingSpeed" Header="语速" Minimum="-50" Maximum="100"
                                            StepFrequency="10" SmallChange="10" LargeChange="20" SnapsTo="StepValues"
                                            TickFrequency="10" TickPlacement="BottomRight" IsThumbToolTipEnabled="True"
                                            Value="0" ValueChanged="ReadingSpeed_ValueChanged"
                                            automation:AutomationProperties.Name="语速"
                                            automation:AutomationProperties.HelpText="0 为正常，负值减慢，正值加快；每档 10。" />
                                    <Grid x:Name="ReadingSpeedLabels" Margin="0,-8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="较慢 -50" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="ReadingSpeedValue" Grid.Column="1" Text="当前值：0（正常）"
                                                   FontSize="12" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="较快 +100" FontSize="12" HorizontalAlignment="Right"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                    <Button Content="保存朗读设置" Click="ReadingSave_Click" />
                                </StackPanel>
                            </Border>
                            <Border Padding="18" CornerRadius="8" BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="12">
                                    <TextBox x:Name="ReadingTextBox" Header="试用朗读" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="220"
                                             MaxLength="30000" PlaceholderText="在这里粘贴想听的段落，或使用全局快捷键。" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="ReadingButton" Content="朗读文字" Click="ReadingButton_Click" />
                                        <Button x:Name="ReadingPause" Content="暂停" IsEnabled="False" Click="ReadingPause_Click" />
                                        <Button x:Name="ReadingStop" Content="停止" IsEnabled="False" Click="ReadingStop_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="ReadingStatus" Text="开启并保存后即可使用。准备音频时显示加载状态，播放时波纹跟随音量变化。" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="TranslationPage" Spacing="12" Visibility="Collapsed">
                            <Border Padding="18" CornerRadius="8" BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="12">

                                    <ComboBox x:Name="TranslationModelPicker" Header="翻译模型"
                                              SelectedIndex="0" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Qwen3.5 LiveTranslate Flash" />
                                    </ComboBox>
                                    <TextBox x:Name="TranslationWorkspace" Header="Workspace ID" PlaceholderText="ws-..." />
                                    <PasswordBox x:Name="TranslationApiKey" Header="翻译 API Key" PlaceholderText="填写翻译服务的 API Key（必填）" PasswordRevealMode="Peek" />
                                    <ComboBox x:Name="TranslationLanguage" Header="字幕语言" SelectedIndex="0" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="中文" />
                                        <ComboBoxItem Content="English" />
                                    </ComboBox>
                                    <Button x:Name="TranslationButton" Content="开始翻译" Click="TranslationButton_Click" />
                                    <TextBlock x:Name="TranslationStatus" Text="自动识别源语言；停止后等待最后一段译文返回。" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="CleanupPage" Spacing="12" Visibility="Collapsed">
                            <Border
                                Padding="18"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Spacing="16">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="4">
                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="去掉末尾句号" />
                                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="保留句中标点、问号和感叹号。" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="TrimTrailingPeriodToggle" Grid.Column="1" VerticalAlignment="Center"
                                                      OffContent="" OnContent="" MinWidth="0"
                                                      automation:AutomationProperties.Name="去掉末尾句号"
                                                      Toggled="TextCleanupToggle_Toggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <InfoBar x:Name="ErrorInfo" IsClosable="True" IsOpen="False" Severity="Error" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
