<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Shuo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    Title="说">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.Resources>
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="16" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="说">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView x:Name="SettingsNavigation" Grid.Row="1"
                        PaneDisplayMode="Left" OpenPaneLength="200"
                        IsPaneOpen="False"
                        IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                        AlwaysShowHeader="False" SelectionChanged="SettingsNavigation_SelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="GeneralNavigationItem" Content="常规" Tag="general" Icon="Setting">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="UpdateInfoBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="TranscriptionNavigationItem" Content="转录服务" Tag="transcription" Icon="Microphone" />
                <NavigationViewItem Content="实时翻译" Tag="translation" Icon="Globe" />
                <NavigationViewItem x:Name="ReadingNavigationItem" Content="实时朗读" Tag="reading" Icon="Volume" />
                <NavigationViewItem Content="转录历史" Tag="history" Icon="Clock" />
            </NavigationView.MenuItems>
            <Grid x:Name="PageViewport" SizeChanged="PageViewport_SizeChanged">
                <ScrollViewer x:Name="PageScroll" HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="SettingsContent" Width="640" HorizontalAlignment="Center"
                                Margin="0,36,0,36" Spacing="24">
                        <StackPanel x:Name="PageSurface" Spacing="24">
                            <TextBlock x:Name="PageTitle" Text="转录服务"
                                       Style="{StaticResource TitleTextBlockStyle}" />
                            <Grid>
                        <StackPanel x:Name="HistoryPage" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="完成转录后自动保存最终文字。记录仅保存在这台电脑上，重启后仍可查看。"
                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="HistorySearch" PlaceholderText="搜索全部记录的文字、日期或服务"
                                     automation:AutomationProperties.Name="搜索转录历史" TextChanged="HistorySearch_TextChanged" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="打开历史文件" Click="OpenHistory_Click" />
                                <Button Content="导出并打开文本" Click="ExportHistory_Click" />
                                <Button Content="刷新" Click="RefreshHistory_Click" />
                                <TextBlock x:Name="HistoryCount" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="HistoryNotice" TextWrapping="Wrap" />
                            <TextBlock x:Name="HistoryEmpty" Text="还没有转录记录。完成一次听写后会显示在这里。" TextWrapping="Wrap" />
                            <ItemsControl x:Name="HistoryItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16" Margin="0,0,0,16" CornerRadius="8" BorderThickness="1"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayTime}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{Binding DisplayProvider}" TextWrapping="Wrap"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="复制" Tag="{Binding Text}" Click="CopyHistory_Click" />
                                                </Grid>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="MoreHistoryButton" Content="加载更多" Click="MoreHistory_Click" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel x:Name="GeneralPage" Spacing="16" Visibility="Collapsed">
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="去掉末尾句号" VerticalAlignment="Center"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <ToggleSwitch x:Name="TrimTrailingPeriodToggle" Grid.Column="1" VerticalAlignment="Center"
                                                  OffContent="" OnContent="" MinWidth="0"
                                                  automation:AutomationProperties.Name="去掉末尾句号"
                                                  Toggled="TextCleanupToggle_Toggled" />
                                </Grid>
                            </Border>
                            <Border Padding="16" CornerRadius="8" BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="版本与更新" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="AppVersionLabel" IsTextSelectionEnabled="True" />
                                    <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click" />
                                        <Button x:Name="InstallUpdateButton" Content="更新并重启" Click="InstallUpdate_Click" Visibility="Collapsed" />
                                    </StackPanel>
                                    <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="关闭窗口后仍在托盘运行。右键托盘图标可退出。" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="TranscriptionPage" Spacing="16">
                            <StackPanel x:Name="TranscriptionConfiguration" Spacing="4">
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="听写快捷键" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <Button x:Name="TranscriptionShortcutButton" Grid.Column="1"
                                                Content="Ctrl + Alt + \" Click="TranscriptionShortcut_Click"
                                                automation:AutomationProperties.Name="更改听写快捷键" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="120" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="转录服务" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <ComboBox x:Name="ProviderPicker" Grid.Column="1" SelectedIndex="0"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                  SelectionChanged="ProviderPicker_SelectionChanged">
                                            <ComboBoxItem Content="本地模型" />
                                            <ComboBoxItem Content="火山引擎" />
                                            <ComboBoxItem Content="阿里云百炼" />
                                            <ComboBoxItem Content="自托管（MLX）" />
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <StackPanel x:Name="CloudFields" Spacing="4" Visibility="Collapsed">
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" MinWidth="120" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="识别模型" VerticalAlignment="Center"
                                                       Style="{StaticResource BodyTextBlockStyle}" />
                                            <ComboBox x:Name="DoubaoModelPicker" Grid.Column="1" SelectedIndex="0"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                <ComboBoxItem Content="豆包流式语音识别模型 2.0" />
                                                <ComboBoxItem Content="豆包流式语音识别模型 1.0" />
                                                <ComboBoxItem Content="自定义资源" />
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" MinWidth="120" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="语音控制台 API Key" VerticalAlignment="Center"
                                                       Style="{StaticResource BodyTextBlockStyle}" />
                                            <PasswordBox x:Name="CloudApiKey" Grid.Column="1" PasswordRevealMode="Peek"
                                                         VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Expander x:Name="DoubaoResourceSettings" Header="旧版控制台凭据与资源设置"
                                              Margin="0,4,0,0" HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="4" Margin="0,4,0,0">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <Grid ColumnSpacing="24">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" MinWidth="120" />
                                                        <ColumnDefinition Width="3*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="App ID" VerticalAlignment="Center"
                                                               Style="{StaticResource BodyTextBlockStyle}" />
                                                    <TextBox x:Name="CloudAppId" Grid.Column="1" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <Grid ColumnSpacing="24">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" MinWidth="120" />
                                                        <ColumnDefinition Width="3*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Access Token" VerticalAlignment="Center"
                                                               Style="{StaticResource BodyTextBlockStyle}" />
                                                    <PasswordBox x:Name="CloudAccessToken" Grid.Column="1"
                                                                 PasswordRevealMode="Peek" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <Grid ColumnSpacing="24">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" MinWidth="120" />
                                                        <ColumnDefinition Width="3*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="资源 ID" VerticalAlignment="Center"
                                                               Style="{StaticResource BodyTextBlockStyle}" />
                                                    <TextBox x:Name="CloudResourceId" Grid.Column="1"
                                                             Text="volc.seedasr.sauc.duration" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                                <StackPanel x:Name="QwenFields" Spacing="4" Visibility="Collapsed">
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" MinWidth="120" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="识别模型" VerticalAlignment="Center"
                                                       Style="{StaticResource BodyTextBlockStyle}" />
                                            <ComboBox x:Name="QwenModelPicker" Grid.Column="1" SelectedIndex="0"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                <ComboBoxItem Content="Fun-ASR-Realtime" />
                                                <ComboBoxItem Content="Qwen3-ASR-Flash-Realtime" />
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" MinWidth="120" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="百炼 API Key" VerticalAlignment="Center"
                                                       Style="{StaticResource BodyTextBlockStyle}" />
                                            <PasswordBox x:Name="QwenApiKey" Grid.Column="1"
                                                         automation:AutomationProperties.Name="百炼 API Key"
                                                         PasswordRevealMode="Peek" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel x:Name="SelfHostedFields" Spacing="4" Visibility="Collapsed">
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" MinWidth="120" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="识别模型" VerticalAlignment="Center"
                                                       Style="{StaticResource BodyTextBlockStyle}" />
                                            <ComboBox x:Name="SelfHostedModelPicker" Grid.Column="1" SelectedIndex="0"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                <ComboBoxItem Content="Qwen3-ASR 1.7B" />
                                                <ComboBoxItem Content="Qwen3-ASR 0.6B" />
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" MinWidth="120" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="主机 IP" VerticalAlignment="Center"
                                                       Style="{StaticResource BodyTextBlockStyle}" />
                                            <TextBox x:Name="SelfHostedUrl" Grid.Column="1"
                                                     PlaceholderText="输入 Mac 的 Tailscale IP，如 100.x.x.x"
                                                     automation:AutomationProperties.Name="自托管主机 IP"
                                                     VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="自托管连接" Style="{StaticResource BodyTextBlockStyle}" />
                                                <TextBlock Text="音频发送到你部署的识别服务。服务所在电脑需保持在线。"
                                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Button x:Name="SelfHostedTestButton" Grid.Column="1" Content="测试连接"
                                                    VerticalAlignment="Center" Click="SelfHostedTest_Click" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <Border x:Name="LocalModelCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="120" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="识别模型" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <Grid Grid.Column="1" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ComboBox x:Name="ModelPicker" HorizontalAlignment="Stretch"
                                                      IsEnabled="False" PlaceholderText="正在读取模型..."
                                                      DisplayMemberPath="Name" MaxDropDownHeight="320"
                                                      automation:AutomationProperties.Name="转录模型"
                                                      SelectionChanged="ModelPicker_SelectionChanged" />
                                            <Button x:Name="DownloadModelButton" Grid.Column="1" Content="下载" Margin="8,0,0,0"
                                                    Visibility="Collapsed" VerticalAlignment="Top"
                                                    ToolTipService.ToolTip="下载 Qwen3-ASR-0.6B Q8_0，约 811 MB"
                                                    Click="DownloadModelButton_Click" />
                                            <ProgressBar x:Name="ModelDownloadProgress" Grid.Row="1" Grid.ColumnSpan="2"
                                                         Visibility="Collapsed" Maximum="100" />
                                            <TextBlock x:Name="ModelDownloadStatus" Grid.Row="2" Grid.ColumnSpan="2"
                                                       Visibility="Collapsed" TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="CloudStatus" Visibility="Collapsed"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border x:Name="DictationTrialCard" Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="试用听写" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBox MinHeight="100" AcceptsReturn="True" TextWrapping="Wrap"
                                             PlaceholderText="今天的天气不错，我们来试试语音输入。"
                                             automation:AutomationProperties.Name="听写试用输入框" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="ReadingPage" Spacing="16" Visibility="Collapsed">
                            <StackPanel x:Name="ReadingConfiguration" Spacing="4">
                                <Border Padding="16" CornerRadius="8" BorderThickness="1"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="启用实时朗读" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <ToggleSwitch x:Name="ReadingEnabled" Grid.Column="1" MinWidth="0"
                                                      OffContent="" OnContent="" VerticalAlignment="Center"
                                                      automation:AutomationProperties.Name="启用实时朗读"
                                                      Toggled="ReadingToggle_Changed" />
                                    </Grid>
                                </Border>
                                <Border Padding="16" CornerRadius="8" BorderThickness="1"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="朗读快捷键" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <Button x:Name="ReadingShortcutButton" Grid.Column="1" Content="Ctrl + Alt + Space"
                                                Click="ReadingShortcut_Click"
                                                automation:AutomationProperties.Name="更改朗读快捷键" />
                                    </Grid>
                                </Border>
                                <Border Padding="16" CornerRadius="8" BorderThickness="1"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="使用转录服务 API Key" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <ToggleSwitch x:Name="ReadingUseExistingKey" Grid.Column="1" IsOn="True" MinWidth="0"
                                                      OffContent="" OnContent="" VerticalAlignment="Center"
                                                      automation:AutomationProperties.Name="使用转录服务 API Key"
                                                      Toggled="ReadingToggle_Changed" />
                                    </Grid>
                                </Border>
                                <Border x:Name="ReadingApiKeyCard" Padding="16" CornerRadius="8" BorderThickness="1"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Visibility="Collapsed">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="120" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="朗读 API Key" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <PasswordBox x:Name="ReadingApiKey" Grid.Column="1" VerticalAlignment="Center"
                                                     PasswordRevealMode="Peek"
                                                     automation:AutomationProperties.Name="朗读 API Key" />
                                    </Grid>
                                </Border>
                                <Border Padding="16" CornerRadius="8" BorderThickness="1"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="120" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="音色" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <ComboBox x:Name="ReadingSpeaker" Grid.Column="1" HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"
                                                  DisplayMemberPath="Name" MaxDropDownHeight="320"
                                                  automation:AutomationProperties.Name="朗读音色" />
                                    </Grid>
                                </Border>
                                <Border Padding="16" CornerRadius="8" BorderThickness="1"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="120" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="语速" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <Slider x:Name="ReadingSpeed" Minimum="-50" Maximum="100"
                                                    StepFrequency="10" SmallChange="10" LargeChange="20" SnapsTo="StepValues"
                                                    TickFrequency="10" TickPlacement="BottomRight" IsThumbToolTipEnabled="True"
                                                    Value="0" ValueChanged="ReadingSpeed_ValueChanged"
                                                    automation:AutomationProperties.Name="语速"
                                                    automation:AutomationProperties.HelpText="0 为正常，负值减慢，正值加快；每档 10。" />
                                            <Grid x:Name="ReadingSpeedLabels" Margin="0,-8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="-50" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="ReadingSpeedValue" Grid.Column="1" Text="0（正常）"
                                                           Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="+100" HorizontalAlignment="Right"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Button x:Name="ReadingSaveButton" Margin="0,12,0,0" HorizontalAlignment="Right"
                                        Content="保存朗读设置" Style="{StaticResource AccentButtonStyle}"
                                        Click="ReadingSave_Click" />
                            </StackPanel>
                            <Border Padding="16" CornerRadius="8" BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="12">
                                    <TextBox x:Name="ReadingTextBox" Header="试用朗读" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="220"
                                             MaxLength="30000" PlaceholderText="输入要朗读的文字" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="ReadingButton" Content="朗读文字" Click="ReadingButton_Click" />
                                        <Button x:Name="ReadingPause" Content="暂停" IsEnabled="False" Click="ReadingPause_Click" />
                                        <Button x:Name="ReadingStop" Content="停止" IsEnabled="False" Click="ReadingStop_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="ReadingStatus" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="TranslationPage" Spacing="16" Visibility="Collapsed">
                            <StackPanel x:Name="TranslationConfiguration" Spacing="4">
                                <Border Padding="16" CornerRadius="8" BorderThickness="1"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="启用实时翻译" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <ToggleSwitch x:Name="TranslationEnabled" Grid.Column="1" MinWidth="0"
                                                      OffContent="" OnContent="" VerticalAlignment="Center"
                                                      automation:AutomationProperties.Name="启用实时翻译"
                                                      Toggled="TranslationToggle_Changed" />
                                    </Grid>
                                </Border>
                                <Border Padding="16" CornerRadius="8" BorderThickness="1"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="翻译快捷键" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <Button x:Name="TranslationShortcutButton" Grid.Column="1" Content="Ctrl + Alt + T"
                                                Click="TranslationShortcut_Click"
                                                automation:AutomationProperties.Name="更改翻译快捷键" />
                                    </Grid>
                                </Border>
                                <Border Padding="16" CornerRadius="8" BorderThickness="1"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="120" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="翻译模型" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <ComboBox x:Name="TranslationModelPicker" Grid.Column="1" SelectedIndex="0"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                            <ComboBoxItem Content="Qwen3.5 LiveTranslate Flash" />
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <Border Padding="16" CornerRadius="8" BorderThickness="1"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="120" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Workspace ID" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <TextBox x:Name="TranslationWorkspace" Grid.Column="1" PlaceholderText="ws-..."
                                                 VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Padding="16" CornerRadius="8" BorderThickness="1"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="120" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="翻译 API Key" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <PasswordBox x:Name="TranslationApiKey" Grid.Column="1"
                                                     PlaceholderText="填写翻译服务的 API Key（必填）"
                                                     PasswordRevealMode="Peek" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Padding="16" CornerRadius="8" BorderThickness="1"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="120" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="字幕语言" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <ComboBox x:Name="TranslationLanguage" Grid.Column="1" SelectedIndex="0"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                            <ComboBoxItem Content="中文" />
                                            <ComboBoxItem Content="English" />
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <Button x:Name="TranslationSaveButton" Margin="0,12,0,0" HorizontalAlignment="Right"
                                        Content="保存翻译设置" Style="{StaticResource AccentButtonStyle}"
                                        Click="TranslationSave_Click" />
                            </StackPanel>
                            <Border Padding="16" CornerRadius="8" BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="实时翻译" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Name="TranslationStatus"
                                                   Text="自动识别源语言；停止后等待最后一段译文返回。"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button x:Name="TranslationButton" Grid.Column="1" Content="开始翻译"
                                            VerticalAlignment="Center" Click="TranslationButton_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>
                            </Grid>
                        </StackPanel>
                        <InfoBar x:Name="ErrorInfo" IsClosable="True" IsOpen="False" Severity="Error" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
