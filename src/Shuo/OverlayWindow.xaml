<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Shuo.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shuo">
    <Grid x:Name="OverlayRoot" Background="Transparent">
    <Border x:Name="OverlaySurface" BorderThickness="1" CornerRadius="0" Padding="5,0">
        <Border.Background><SolidColorBrush x:Name="SurfaceBrush" Color="#0C0C0C" /></Border.Background>
        <Border.BorderBrush><SolidColorBrush x:Name="SurfaceBorderBrush" Color="#303030" /></Border.BorderBrush>
        <Grid x:Name="TrackGrid" ColumnSpacing="0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>
            <Grid x:Name="VoiceSlot" Width="24" Height="24" VerticalAlignment="Center" IsHitTestVisible="False">
                <Grid x:Name="VoiceIndicator">
                    <Ellipse x:Name="VoiceHalo" Width="14" Height="14" Opacity="0.10"
                             Fill="{ThemeResource SystemControlHighlightAccentBrush}"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="HaloScale" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="RippleOne" Width="24" Height="24" StrokeThickness="1"
                             Stroke="{ThemeResource SystemControlHighlightAccentBrush}"
                             Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="RippleOneScale" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="RippleTwo" Width="24" Height="24" StrokeThickness="1"
                             Stroke="{ThemeResource SystemControlHighlightAccentBrush}"
                             Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="RippleTwoScale" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="6" Height="6" RenderTransformOrigin="0.5,0.5"
                             Fill="{ThemeResource SystemControlHighlightAccentBrush}">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="DotScale" /></Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <ProgressRing x:Name="BusyRing" Width="10" Height="10"
                              IsActive="False" Visibility="Collapsed" />
            </Grid>
            <ScrollViewer x:Name="CaptionScroll" Grid.Row="0" Grid.ColumnSpan="2" Margin="6,8,0,0"
                          Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Enabled" ViewChanged="CaptionScroll_ViewChanged">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="12" />
                        <Setter Property="MinWidth" Value="12" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid x:Name="VerticalRoot" Background="Transparent">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <RepeatButton x:Name="VerticalLargeDecrease" Height="0" IsTabStop="False" AllowFocusOnInteraction="False">
                                            <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                                        </RepeatButton>
                                        <Thumb x:Name="VerticalThumb" Grid.Row="1" MinHeight="28" Width="12">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid Background="Transparent">
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="CommonStates">
                                                                <VisualState x:Name="Normal" />
                                                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Pill.Opacity" Value="0.8" /></VisualState.Setters></VisualState>
                                                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Pill.Opacity" Value="1" /></VisualState.Setters></VisualState>
                                                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Pill.Opacity" Value="0.2" /></VisualState.Setters></VisualState>
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>
                                                        <Border x:Name="Pill" Width="4" CornerRadius="2" Background="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.5" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                        <RepeatButton x:Name="VerticalLargeIncrease" Grid.Row="2" IsTabStop="False" AllowFocusOnInteraction="False">
                                            <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                                        </RepeatButton>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>
                <TextBlock x:Name="CaptionHistory" FontSize="18" LineHeight="26" LineStackingStrategy="BlockLineHeight"
                           TextWrapping="Wrap" Foreground="{Binding Foreground, ElementName=TranscriptText}" />
            </ScrollViewer>
            <local:OverlayDragHandle x:Name="CaptionMoveArea" Grid.Row="1" Grid.ColumnSpan="2"
                                     CursorShape="SizeAll" Background="Transparent" Visibility="Collapsed"
                                     />
            <Canvas x:Name="TextViewport" Grid.Column="1" Height="22"
                    VerticalAlignment="Center" SizeChanged="TextViewport_SizeChanged" IsHitTestVisible="False">
                <Canvas.Clip>
                    <RectangleGeometry x:Name="TextClip" />
                </Canvas.Clip>
                <TextBlock x:Name="TranscriptText" LineHeight="22" TextWrapping="NoWrap"
                           Style="{StaticResource BodyTextBlockStyle}">
                    <TextBlock.Foreground><SolidColorBrush x:Name="TranscriptBrush" Color="#F5F5F5" /></TextBlock.Foreground>
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TextOffset" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Canvas>
            <StackPanel x:Name="ReadingControls" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed">
                <Button x:Name="ReadingPauseButton" Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0" IsTabStop="False"
                        AutomationProperties.Name="暂停朗读" ToolTipService.ToolTip="暂停朗读" Click="ReadingPauseButton_Click">
                    <Grid Width="16" Height="16">
                        <PathIcon x:Name="ReadingPauseBars" Width="10" Height="14"
                                  Data="M 0,0 L 1.2,0 L 1.2,14 L 0,14 Z M 8.8,0 L 10,0 L 10,14 L 8.8,14 Z" />
                        <FontIcon x:Name="ReadingPauseIcon" Glyph="&#xE768;" FontSize="16" Visibility="Collapsed" />
                    </Grid>
                </Button>
                <Button x:Name="ReadingStopButton" Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0" IsTabStop="False"
                        AutomationProperties.Name="停止朗读" ToolTipService.ToolTip="停止朗读" Click="ReadingStopButton_Click">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                </Button>
            <Button x:Name="ReadingCloseButton"
                    Width="32" Height="32" Padding="0" Visibility="Collapsed"
                    Background="Transparent" BorderThickness="0" IsTabStop="False"
                    AutomationProperties.Name="关闭朗读播放器" ToolTipService.ToolTip="停止朗读并关闭"
                    Click="ReadingCloseButton_Click">
                <FontIcon Glyph="&#xE8BB;" FontSize="14" />
            </Button>
            </StackPanel>
        </Grid>
    </Border>
    <Grid x:Name="CaptionResizeEdges" Visibility="Collapsed">
        <local:OverlayDragHandle Tag="1" CursorShape="SizeWestEast" Width="8" Margin="0,16,0,16" HorizontalAlignment="Left" Background="Transparent" />
        <local:OverlayDragHandle Tag="2" CursorShape="SizeWestEast" Width="8" Margin="0,16,0,16" HorizontalAlignment="Right" Background="Transparent" />
        <local:OverlayDragHandle Tag="4" CursorShape="SizeNorthSouth" Height="8" Margin="16,0,16,0" VerticalAlignment="Top" Background="Transparent" />
        <local:OverlayDragHandle Tag="8" CursorShape="SizeNorthSouth" Height="8" Margin="16,0,16,0" VerticalAlignment="Bottom" Background="Transparent" />
        <local:OverlayDragHandle Tag="5" CursorShape="SizeNorthwestSoutheast" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" />
        <local:OverlayDragHandle Tag="6" CursorShape="SizeNortheastSouthwest" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" />
        <local:OverlayDragHandle Tag="9" CursorShape="SizeNortheastSouthwest" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" />
        <local:OverlayDragHandle Tag="10" CursorShape="SizeNorthwestSoutheast" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" />
    </Grid>
    </Grid>
</Window>
