<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Shuo.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="12" Padding="12,0">
        <Grid ColumnSpacing="10" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="10" Height="10" VerticalAlignment="Center">
                <Grid x:Name="VoiceIndicator">
                    <Ellipse x:Name="RippleOne" Width="10" Height="10" StrokeThickness="1"
                             Stroke="{ThemeResource SystemControlHighlightAccentBrush}"
                             Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="RippleOneScale" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="RippleTwo" Width="10" Height="10" StrokeThickness="1"
                             Stroke="{ThemeResource SystemControlHighlightAccentBrush}"
                             Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="RippleTwoScale" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="6" Height="6" RenderTransformOrigin="0.5,0.5"
                             Fill="{ThemeResource SystemControlHighlightAccentBrush}">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="DotScale" /></Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <ProgressRing x:Name="BusyRing" Width="10" Height="10"
                              IsActive="False" Visibility="Collapsed" />
            </Grid>
            <Canvas x:Name="TextViewport" Grid.Column="1" Height="22"
                    VerticalAlignment="Center" SizeChanged="TextViewport_SizeChanged">
                <Canvas.Clip>
                    <RectangleGeometry x:Name="TextClip" />
                </Canvas.Clip>
                <TextBlock x:Name="TranscriptText" FontSize="14" LineHeight="22"
                           TextWrapping="NoWrap">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TextOffset" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Canvas>
        </Grid>
    </Border>
</Window>
