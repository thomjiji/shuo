<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Shuo.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="OverlaySurface" BorderThickness="1" CornerRadius="0" Padding="5,0">
        <Border.Background><SolidColorBrush x:Name="SurfaceBrush" Color="#0C0C0C" /></Border.Background>
        <Border.BorderBrush><SolidColorBrush x:Name="SurfaceBorderBrush" Color="#303030" /></Border.BorderBrush>
        <Grid x:Name="TrackGrid" ColumnSpacing="0" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="24" Height="24" VerticalAlignment="Center">
                <Grid x:Name="VoiceIndicator">
                    <Ellipse x:Name="VoiceHalo" Width="14" Height="14" Opacity="0.10"
                             Fill="{ThemeResource SystemControlHighlightAccentBrush}"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="HaloScale" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="RippleOne" Width="24" Height="24" StrokeThickness="1"
                             Stroke="{ThemeResource SystemControlHighlightAccentBrush}"
                             Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="RippleOneScale" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="RippleTwo" Width="24" Height="24" StrokeThickness="1"
                             Stroke="{ThemeResource SystemControlHighlightAccentBrush}"
                             Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="RippleTwoScale" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="6" Height="6" RenderTransformOrigin="0.5,0.5"
                             Fill="{ThemeResource SystemControlHighlightAccentBrush}">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="DotScale" /></Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <ProgressRing x:Name="BusyRing" Width="10" Height="10"
                              IsActive="False" Visibility="Collapsed" />
            </Grid>
            <Canvas x:Name="TextViewport" Grid.Column="1" Height="22"
                    VerticalAlignment="Center" SizeChanged="TextViewport_SizeChanged">
                <Canvas.Clip>
                    <RectangleGeometry x:Name="TextClip" />
                </Canvas.Clip>
                <TextBlock x:Name="TranscriptText" FontSize="14" LineHeight="22"
                           TextWrapping="NoWrap">
                    <TextBlock.Foreground><SolidColorBrush x:Name="TranscriptBrush" Color="#F5F5F5" /></TextBlock.Foreground>
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TextOffset" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Canvas>
        </Grid>
    </Border>
</Window>
